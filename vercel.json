{
  "version": 2,
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.mjs" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ],
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "api/live-scan.mjs": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
